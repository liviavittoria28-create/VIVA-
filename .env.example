# Copie para .env e preencha. Nunca commite o arquivo .env.

# Projeto Supabase (chave pública; a proteção vem do RLS)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Ambiente
VITE_APP_ENV=development
VITE_APP_NAME=VIVA+

# NUNCA coloque aqui a service_role key nem use prefixo VITE_ para ela.
# SUPABASE_SERVICE_ROLE_KEY=  (somente em ambiente de servidor seguro)
